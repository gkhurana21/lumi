# PROVIDERS: "fake" runs the whole loop offline (canned speech, no keys).
#            "gemini" uses one Google AI Studio key for speech-to-text, dialogue, scene vision, and voice.
#            "cloud" uses Anthropic (dialogue, vision) + OpenAI (speech-to-text, voice).
PROVIDERS=fake

# gemini: https://aistudio.google.com/apikey . Free-tier limits are per model; check them in AI Studio.
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_VOICE=Charon
GEMINI_VOICE_LANG=en-GB
GEMINI_THINKING=MINIMAL

# cloud
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
VISION_MODEL=claude-haiku-4-5-20251001
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Seconds between background scene scans (goals always re-scan immediately). 15 keeps Gemini's free tier comfortable.
SCENE_INTERVAL_S=15
URDF_PATH=robot/dummy_lamp_5dof.urdf
SIM=true
MEMORY=chroma
ATTENTION=mediapipe
